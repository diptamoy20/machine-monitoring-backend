DB_HOST=192.168.1.30
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=machine_monitoring
FRONTEND_URL=http://localhost:5173

# YOLO Inference
YOLO_MODEL_PATH=app/ml/yolo/weights/best.pt
YOLO_VIDEO_DIR=app/static/videos
YOLO_DEVICE=cpu
YOLO_CONFIDENCE_THRESHOLD=0.5
YOLO_SMOOTHING_WINDOW=10
# Leave YOLO_MAX_FRAMES blank to process all frames, or set a number (e.g. 100) to limit for speed
YOLO_MAX_FRAMES=
